# 复制成 .env 再填

# 模型：OpenAI 兼容接口（国产模型如 DeepSeek、通义千问的兼容地址也可以）
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
CHEAP_MODEL=
STRONG_MODEL=

# 或者 Azure OpenAI（CHEAP_MODEL / STRONG_MODEL 填部署名）
# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://<资源名>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21

# 检索（不填则只抓 companies.json 里的种子链接）
TAVILY_API_KEY=

# 提醒推送：飞书或企业微信群机器人
# ALERT_WEBHOOK=
# ALERT_WEBHOOK_KIND=feishu
